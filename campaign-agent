#!/bin/zsh
# campaign-agent: launcher for the Python campaign agent (replaces run-one-job).
#
# Invoked by the Director as `job-search-agent` (PATH symlink) or directly.
# The zsh parent stays alive for the duration of the run with
# '/bin/zsh <path>/job-search-agent' in its command line - this is what the
# Director's pgrep-based supervision (detectWorker) matches, exactly like the
# old run-one-job launcher. The python child does the campaign work.
set -euo pipefail

# Resolve the real launcher directory even when invoked through a PATH symlink.
LAUNCHER_DIR="$(python3 -c 'import os, sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "$0")"
cd "$LAUNCHER_DIR/campaign_agent" || exit 1

export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"
.venv/bin/python -m campaign_agent.main
