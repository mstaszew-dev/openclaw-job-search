#!/bin/zsh
set -uo pipefail
set +o nomatch

cd /Users/mst/ZCodeProject/openclaw-job-search

# Director overrides: optional env-style file sourced every launch (NOT every
# tick - the Director restarts the campaign to apply new overrides). Empty or
# absent file = no-op; the defaults below win. The Director writes here on
# Slack approval to steer pacing, skip a misbehaving portal, cap daily volume,
# or leave a note for the agent. Keep all overrides env-var-shaped (KEY=VALUE).
DIRECTOR_OVERRIDES="${DIRECTOR_OVERRIDES:-$HOME/.openclaw/director-overrides.env}"
[[ -f "$DIRECTOR_OVERRIDES" ]] && source "$DIRECTOR_OVERRIDES"

if ! curl -fsS --max-time 2 http://127.0.0.1:9222/json/version >/dev/null; then
  print -u2 "Chrome CDP is not reachable at http://127.0.0.1:9222. Start the existing campaign Chrome first."
  exit 2
fi

TRACKER=/Users/mst/Downloads/job-search/job-apply/tracker.json

# Target: CLI override (first arg of form N=1300) else tracker.targetApplications (default 1200).
TARGET_OVERRIDE=""
if [[ "${1:-}" == N=* ]]; then
  TARGET_OVERRIDE="${1#N=}"
  shift
fi

DEFAULT_MESSAGE=$(cat <<'EOM'
HARD RULES (do not violate):
1. NEVER edit, write, or rewrite tracker.json directly. The schema is FIXED. ALWAYS use \`update_tracker.py\` (e.g. \`update_tracker.py submitted '<candidate json>'\`) to record a submission. Direct file writes to tracker.json corrupt the dedupe array and reset the count - this already caused a full tracker reset once. Note: update_tracker.py is ONLY for recording new events (submitted/skipped/etc.) -- it does NOT rebuild or repair the tracker.
2. tracker.json schema is: { stats: {submitted, skippedDuplicate, ...}, targetApplications, applications: [...] }. Do not add, rename, or 'improve' fields.
3. CRITICAL: After verifying a successful submission in the browser, use the shell/exec tool to run \`update_tracker.py submitted '<json>'\` IMMEDIATELY as your very next action. Do NOT write the command in a markdown code block — code blocks are just text and do nothing. You must actually INVOKE the exec tool to run the command. Do NOT browse more listings, do NOT check other tabs, do NOT do anything else first. The session may be rotated at any time and you will lose the chance to record. If you verified submission but did not call update_tracker.py, the application counts as LOST.

Continue the campaign. Apply exactly ONE job this tick. Read campaign/AGENT_TICK.md and campaign/CONTEXT.md first. You are an autonomous agent — use your LLM reasoning and tools, do NOT call automation scripts (no score_candidate.py, no check_dupe.py, no python3 preflight scripts). Only \`update_tracker.py\` is allowed, and only to record a confirmed submission.

Use the existing logged-in Chrome through Playwright MCP at http://127.0.0.1:9222 (do NOT launch or close Chrome). Search Gmail inbox + sent (60d) via Playwright for dedupe. Score candidates yourself against your CV knowledge. Verify an explicit confirmation/thank-you in the browser before running update_tracker.py submitted.

IMPORTANT EXECUTION RULE: Do NOT ask the user if you should proceed with a candidate. You are authorized to apply. Asking "Would you like me to begin?" or similar wastes an entire tick. Just execute the next action.

Allowed boards/sites (these are all permitted; prefer the listed primary portals first, then fall back to others):
- IL (remote/hybrid/on-site all OK, incl. central Israel): AllJobs, Drushim, JobMaster, Jobnet, Janglo, Secret Tel Aviv, TopStartups.io, TechJob, DevJobs IL, Nefesh B'Nefesh, NoFluffJobs PL (IL listings); LinkedIn Easy Apply (IL java/spring, node/react, php).
- EU/PL (full remote only, B2B >=15k PLN when salary listed): No Fluff Jobs, Just Join IT, theProtocol, Bulldogjob, Pracuj, plus global remote (We Work Remotely, EU Remote Jobs, Working Nomads, Arc, RemotifyEurope, Remote in Europe, EuroRemote, 4DayWeek.io EU).
Prefer the primary listed portals above; other reputable boards/sites are allowed if they surface a valid in-policy role. Always score against the CV and pass the Gmail 60-day gate.

RAG tools (semantic retrieval over your campaign history - USE THESE instead of re-reading docs or relying only on exact-match dedupe):
- Call \`rag_search_apps\` with the candidate's role + company + stack BEFORE applying. It returns the most similar past applications (semantic dedupe): catches "Senior Java Engineer @ Foo" ~ "Lead JVM Developer @ Foo" you applied 30+ days ago that exact-match misses. If a hit has score > 0.85 AND appliedAt within 60d, SKIP the candidate as a likely duplicate.
- Call \`rag_search_docs\` for portal/recruiter/convention context (e.g. "IL hybrid portal", "Poland B2B note") instead of re-reading PORTALS.md / IL_BOARDS.md / recruiter-contacts every tick. Returns just the matching section.

Work the order: IL remote/hybrid/on-site -> EU/PL full remote -> other EU full remote. Stop after one confirmed submission. Wait for the global submitted count to reach the target before finishing.
EOM
)
message="${*:-$DEFAULT_MESSAGE}"

# Inner rate-limit retry settings (per single apply attempt).
# Override via director-overrides.env (Director writes on Slack approval).
INNER_MAX_FAILS="${INNER_MAX_FAILS:-200}"
INNER_SLEEP="${INNER_SLEEP:-4}"

# Outer-level backoff: when the inner retries are exhausted on a transient error,
# wait this long and re-enter the outer loop (do NOT abort the whole campaign).
OUTER_BACKOFF="${OUTER_BACKOFF:-60}"

# Rotate to a fresh session every tick so the transcript/context stays bounded.
# Prevents context overflow / Compaction timed out / TranscriptNotContinuableError
# from compounding across ticks. Mid-tick overflow recovery via
# classify_failure -> rotate_session still works as a fallback.
SESSION_ROTATE_EVERY_TICK=1

# Outer loop: keep applying until the tracker target is reached.
# Worst case: INNER_MAX_FAILS (200) rate-limit retries per remaining app × 208 apps = 41600.
OUTER_MAX_TICKS="${OUTER_MAX_TICKS:-41600}"
tick=0

# Session identity. Start with the persistent campaign session; rotate on overflow.
SESSION_KEY="agent:main:job-search-campaign"
SESSION_ID=""

# Run one openclaw agent turn. Pass --session-id only when we have a rotated id;
# otherwise rely on --session-key (persistent session). Invoked directly (no
# command substitution) so the quoted --message survives intact. If the Director
# left a DIRECTOR_NOTE in the overrides file or prompt overrides, re-read them
# fresh here (every tick) and prepend to the message.
run_agent() {
  local note=""
  local overrides="${DIRECTOR_OVERRIDES:-$HOME/.openclaw/director-overrides.env}"
  if [[ -f "$overrides" ]]; then
    note="$(grep -E '^DIRECTOR_NOTE=' "$overrides" | head -1 | cut -d= -f2-)"
  fi
  local prompt_overrides=""
  local prompt_md="$HOME/.openclaw/director-prompt-overrides.md"
  if [[ -f "$prompt_md" ]] && [[ -s "$prompt_md" ]]; then
    prompt_overrides="$(cat "$prompt_md")"
  fi
  local msg="${message:-}"
  [[ -n "$prompt_overrides" ]] && msg="$msg\n\n--- Director prompt overrides ---\n$prompt_overrides"
  [[ -n "$note" ]] && msg="[Director note: $note]\n\n$msg"
  local t0=$(date +%s)
  log "run_agent starting (model=free, session=${SESSION_ID:-$SESSION_KEY})"
  log "MCP tools available: playwright (CDP :9222), rag (semantic search)"
  if [[ -n "$SESSION_ID" ]]; then
    /Users/mst/bin/openclaw agent \
      --agent main \
      --model free \
      --timeout 1200 \
      --thinking medium \
      --session-id "$SESSION_ID" \
      --message "$msg"
  else
    /Users/mst/bin/openclaw agent \
      --agent main \
      --model free \
      --timeout 1200 \
      --thinking medium \
      --session-key "$SESSION_KEY" \
      --message "$msg"
  fi
  local rc=$?
  local t1=$(date +%s)
  log "run_agent finished (exit=$rc, elapsed=$((t1-t0))s, session=${SESSION_ID:-$SESSION_KEY})"
  return $rc
}

# Rotate to a brand-new session (fresh context) to recover from overflow/compaction.
rotate_session() {
  SESSION_ID="$(uuidgen | tr 'A-Z' 'a-z')"
  print -u2 "[$(ts)] Rotating to a fresh session ($SESSION_ID) to clear bloated context."
}

# Timestamped console helpers.
ts() { date '+%H:%M:%S' }
log()  { print "[$(ts)] $*" }            # informational (stdout)
warn() { print -u2 "[$(ts)] $*" }        # warnings/retries (stderr)

# Classify an agent failure output.
#   echo "rate"      -> plain rate limit / timeout / transient gateway (retry same session)
#   echo "context"   -> context overflow / compaction (rotate session, retry)
#   echo "transient" -> other transient provider errors (model-not-found, failover, API limit) (retry, outer backoff)
#   echo "fatal"     -> genuinely non-recoverable (auth/config/no-credits hard stop)
# Classify an agent failure output.
#   echo "rate"      -> plain rate limit / timeout / transient gateway (retry same session)
#   echo "context"   -> context overflow / compaction (rotate session, retry)
#   echo "transient" -> other transient provider errors (model-not-found, failover, API limit) (retry, outer backoff)
#   echo "fatal"     -> genuinely non-recoverable (auth/config/no-credits hard stop)
classify_failure() {
  local o="$1"
  # Streaming failures (FailoverError, streaming response failed) are TRANSIENT provider errors,
  # NOT context overflow. Check these FIRST before compaction patterns.
  if echo "$o" | grep -qiE 'FailoverError|Streaming response failed|streaming response failed|stream.*fail|all providers failed|NO_PROVIDER_AVAILABLE'; then
    print "transient"; return
  fi
  if echo "$o" | grep -qiE 'context overflow|prompt too large|Compaction timed out|token.*(limit|too large)|maximum context'; then
    print "context"; return
  fi
  if echo "$o" | grep -qiE 'rate limit|Retry-After|429|Too Many Requests|timed out|timeout|transient|GatewayClient|ECONN|ETIMEDOUT|socket'; then
    print "rate"; return
  fi
  if echo "$o" | grep -qiE 'model was not found|API rate limit reached|rate limit reached|service unavailable|503|502|Upstream|assistant turn failed|couldn.t generate a response'; then
    print "transient"; return
  fi
  print "fatal"
}

get_submitted() {
  python3 - "$TRACKER" <<'PY'
import json, sys
t = json.load(open(sys.argv[1]))
s = t.get("stats", {})
print(s.get("submitted", 0))
PY
}

get_target() {
  python3 - "$TRACKER" "$TARGET_OVERRIDE" <<'PY'
import json, sys
t = json.load(open(sys.argv[1]))
override = sys.argv[2]
print(int(override) if override else t.get("targetApplications", 1200))
PY
}

TARGET=$(get_target)
log "Target applications: $TARGET (tracker: $TRACKER)"
log "Model: free (openclaw prefixes openrouter/). Session: $SESSION_KEY (persistent, rotated per tick)."

while (( tick < OUTER_MAX_TICKS )); do
  submitted=$(get_submitted)
  if (( submitted >= TARGET )); then
    print "CAMPAIGN COMPLETE: submitted $submitted >= target $TARGET."
    exit 0
  fi
  log "=== Tick $((tick+1)): submitted=$submitted / target=$TARGET ($(($TARGET - $submitted)) to go) ==="

  fail_count=0
  inner_result="exhausted"   # exhausted | success | fatal
  while (( fail_count < INNER_MAX_FAILS )); do
    sess_label="${SESSION_ID:-$SESSION_KEY (persistent)}"
    log "Attempt $((fail_count+1))/$INNER_MAX_FAILS — model=free session=$sess_label"
    output="$(run_agent 2>&1)"
    rc=$?

    # Inspect output regardless of rc (openclaw outputs context overflow / turn errors with rc=0).
    has_error=0
    if echo "$output" | grep -qiE 'context overflow|prompt too large|compaction failed|Compaction timed out|token.*(limit|too large)|maximum context|assistant turn failed|all providers failed|NO_PROVIDER_AVAILABLE|502|503|couldn.t generate a response'; then
      has_error=1
    fi

    if [[ $rc -eq 0 && $has_error -eq 0 ]]; then
      log "openclaw exit=$rc — streaming agent output:"
      print "$output"
      inner_result="success"
      break   # one apply done; break inner loop, fall through to tick++ and re-check target
    fi

    # Surface what openclaw actually said (first/last lines) for visibility.
    log "openclaw exit=$rc — output (head):"
    print "$output" | head -8 | sed 's/^/    /'

    kind="$(classify_failure "$output")"
    (( fail_count++ ))

    case "$kind" in
      context)
        warn "Context/compaction failure (consecutive fail $fail_count/$INNER_MAX_FAILS). Resetting session before retry..."
        rotate_session
        ;;
      rate)
        warn "Rate limit/timeout (consecutive fail $fail_count/$INNER_MAX_FAILS). Waiting ${INNER_SLEEP}s before retry..."
        ;;
      transient)
        warn "Transient provider error (consecutive fail $fail_count/$INNER_MAX_FAILS). Waiting ${INNER_SLEEP}s before retry..."
        ;;
      fatal)
        warn "openclaw agent failed (fatal, non-recoverable):"
        print "$output"
        inner_result="fatal"
        break
        ;;
    esac

    if (( fail_count >= INNER_MAX_FAILS )); then
      warn "Transient failures persisted after $INNER_MAX_FAILS attempts this tick. Backing off ${OUTER_BACKOFF}s and retrying from the top."
      inner_result="exhausted"
      break
    fi
    sleep "$INNER_SLEEP"
  done

  # A fatal error stops the whole campaign (auth/config/credits).
  if [[ "$inner_result" == "fatal" ]]; then
    warn "Fatal error — stopping the campaign."
    exit $rc
  fi

  if [[ "$inner_result" == "success" ]]; then
    (( tick++ ))
    # Brief pause between ticks so the agent/session can settle.
    sleep 2
  else
    # Exhausted transient retries: back off and re-enter the outer loop (do NOT abort).
    warn "Inner retries exhausted (transient). Backing off ${OUTER_BACKOFF}s before re-entering the loop."
    sleep "$OUTER_BACKOFF"
  fi

# Rotate to a fresh session for the next tick so the transcript/context stays
# bounded (prevents "Context overflow" / "Compaction timed out"). With
# SESSION_ROTATE_EVERY_TICK=1, every tick gets a clean session; the mid-tick
# overflow handler via classify_failure -> rotate_session remains as a fallback.
if (( SESSION_ROTATE_EVERY_TICK )); then
    rotate_session
  fi
done

log "Reached outer safety cap ($OUTER_MAX_TICKS ticks) without hitting target. Exiting."
exit 0
