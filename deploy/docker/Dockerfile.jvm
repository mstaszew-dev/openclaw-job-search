# apply-worker runs on the JVM (GraalVM JDK): the LLM loop and the MCP stdio
# child process iterate faster with JIT, and node/@playwright/mcp must exist in
# the runtime image anyway. Native images for the worker are a later pass.
# Also builds the import-tracker CLI (stage `importer`).
# Base repos have no nodejs20 package: pinned node from the official tarball.
FROM ghcr.io/graalvm/graalvm-community:21 AS build
RUN microdnf install -y curl xz \
 && curl -fsSL https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local \
 && node --version \
 && npm install -g @playwright/mcp@0.0.83 \
 && microdnf clean all
WORKDIR /src
COPY . .
RUN ./gradlew :apply-worker:bootJar :import-tracker:installDist --no-daemon

FROM ghcr.io/graalvm/graalvm-community:21 AS worker
# WORKDIR /app is load-bearing: playwright-mcp restricts browser_file_upload
# to its allowed roots (cwd + output dir), and upload_cv's CV lives at
# /app/cv/... (worker.yaml). Losing this line re-kills the chooser path on
# the next rebuild while the CDP fallback keeps working - a silent regression.
WORKDIR /app
RUN microdnf install -y curl xz \
 && curl -fsSL https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local \
 && node --version \
 && microdnf clean all
COPY --from=build /usr/local/lib/node_modules/@playwright/mcp /opt/playwright-mcp
COPY --from=build /src/apply-worker/build/libs/apply-worker.jar /app/worker.jar
# 2026-10-23 cap-outs: playwright-mcp defaults to 5000ms action AND expect
# timeouts (config.d.ts); slow portals' clicks and post-submit confirmation
# waits ("dziękujemy") routinely need 6-15s. Every 5s timeout burned a step
# and snapshot-interleaved retries ground units to the 80-step cap. There is
# NO --timeout-expect flag, so the config file is the only way to raise the
# expect timeout; --config is verified wired (a missing config path throws at
# startup). Navigation keeps its 60s default. Written inline because the
# docker build context is kotlin/ - deploy/docker is outside it.
RUN printf '%s\n' '{' '  "timeouts": { "action": 30000, "expect": 15000 }' '}' > /app/pw-mcp.json
# the worker drives the SHARED lubuntu Chrome over CDP; node runs the MCP client
ENV WORKER_MCP_COMMAND="node /opt/playwright-mcp/cli.js --cdp-endpoint http://192.168.18.13:30922 --config /app/pw-mcp.json"
# MaxRAMPercentage=75 left no room for the JVM's non-heap plus the MCP node
# child inside the container's cgroup; a mid-apply OOMKill loses an apply.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60", "-jar", "/app/worker.jar"]

FROM eclipse-temurin:21-jre AS importer
COPY --from=build /src/import-tracker/build/install/import-tracker /opt/importer
ENTRYPOINT ["/opt/importer/bin/import-tracker"]
