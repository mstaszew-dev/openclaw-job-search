# Native-image build (finder-service, campaign-api). Run on the lubuntu host
# (amd64, has docker + k3s).
# Runtime keeps node + @playwright/mcp: both services drive the shared Chrome
# through the Playwright MCP stdio client.
# Base repos have no nodejs20 package: install pinned node from the official
# tarball instead of dnf.
FROM ghcr.io/graalvm/graalvm-community:21 AS build
WORKDIR /src
COPY . .
RUN ./gradlew :finder-service:nativeCompile :campaign-api:nativeCompile --no-daemon --no-parallel

FROM ghcr.io/graalvm/graalvm-community:21 AS common-runtime
RUN microdnf install -y curl xz \
 && curl -fsSL https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local \
 && node --version \
 && npm install -g @playwright/mcp@latest \
 && microdnf clean all

FROM common-runtime AS finder
COPY --from=build /src/finder-service/build/native/nativeCompile/finder-service /app/finder-service
EXPOSE 8081
ENTRYPOINT ["/app/finder-service"]

FROM common-runtime AS api
COPY --from=build /src/campaign-api/build/native/nativeCompile/campaign-api /app/campaign-api
EXPOSE 8080
ENTRYPOINT ["/app/campaign-api"]
