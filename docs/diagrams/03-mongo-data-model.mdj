              "visible": true,
              "enabled": true,
              "lineColor": "#000000",
              "fillColor": "#ffffcc",
              "fontColor": "#000000",
              "font": "Arial;12;0",
              "parentStyle": false,
              "containerChangeable": true,
              "containerExtending": true,
              "left": 40,
              "top": 760,
              "width": 560,
              "height": 174,
              "autoResize": false,
              "stereotypeDisplay": "label",
              "wordWrap": true,
              "text": "Notes the metadata does not advertise\nuq_ indexes are not flagged unique in live metadata except\nuq_job_listings_source_job; the packed dedupe tuples are enforced by\nthe write path (insert-if-absent), not by MongoDB.\napplications._id is the assigned String source:sourceJobId, so its\nuniqueness rides on the default _id_ index.\nOnly three write paths use a transaction; single-document writes stay\noutside on purpose.\njob_state is a ledger: it records attempts and outcomes and never\nschedules work.",
              "horzAlign": 0,
              "vertAlign": 0
            },
