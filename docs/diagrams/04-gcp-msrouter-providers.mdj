        },
        {
          "_type": "UMLComponent",
          "_id": "n4IGgD0Y5STMJl1wyqRU",
          "_parent": {
            "$ref": "4Ef5xvn4SuXtmrbWwIGz"
          },
          "name": "pause switch - msrouter.yaml replicas 0 + finder FINDER_SCORING_ENABLED=false",
          "visibility": "public"
        },
        {
          "_type": "UMLNote",
          "_id": "Zi5t0Rywk4P9GgzG1hJA",
          "_parent": {
            "$ref": "4Ef5xvn4SuXtmrbWwIGz"
          },
          "text": "GCP is the Google Gemini slot in msrouter\nBase URL: generativelanguage.googleapis.com/v1beta/openai\nDefault model: gemini-2.5-flash-lite, free tier via GEMINI_API_KEY.\nOrder: unorouter, groq, sambanova, mistral, gemini, cline, cloudflare.\nCloudflare is last in the walk; the local on-host slot comes first.\nWhile msrouter has 0 replicas, CvScorer returns the fallback score 70\nand the score >= 60 CV filter stops rejecting candidates.\nAPPLY_MODE must stay shadow while the pause switch is active."
        },
