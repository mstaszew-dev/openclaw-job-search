<mxfile host="app.diagrams.net" agent="gen_mdj.py" version="24.4.0" type="device"><diagram id="vdMkCUMAnsug7kLyF0ba" name="02 - job pipeline: sources, finder, kafka, worker fleet, db and ui"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2152" pageHeight="854" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="WLD/i6yRZFJo1tDG9PO3" value="External sources - NoFluffJobs, JustJoin.it, theProtocol.it (PL only, fully remote)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="664" height="56" as="geometry"/></mxCell><mxCell id="sYNq+e1CDghlNq4zjRSK" value="finder = Discovery &amp; Deduplication Agent - crawl/API, normalize, hash + similarity dedupe" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="744" y="40" width="664" height="56" as="geometry"/></mxCell><mxCell id="fwxrjThLUIDusi8IVSTF" value="campaign.jobs - Kafka topic, reference name validated_job_offers, 3 partitions, key companyKey" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1448" y="40" width="664" height="56" as="geometry"/></mxCell><mxCell id="d6cC+RS5DCXljIKQ/Jjb" value="apply-worker pool - consumer group apply-workers, one record per poll, ack after the Mongo write" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="664" height="56" as="geometry"/></mxCell><mxCell id="NTTxYsBoBo/KUOJYOo6n" value="worker specialisms (reference) - skill/stack, salary/benefit, company/culture checks" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="744" y="190" width="664" height="56" as="geometry"/></mxCell><mxCell id="NfGjC93EFgH3m4ttaDQt" value="campaign.jobs.dlq - poison messages past maxAttempts -&gt; job_state.status=DEAD" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1448" y="190" width="664" height="56" as="geometry"/></mxCell><mxCell id="jQaBCC1fFFpef9QJ0/pm" value="mongo-0 = Job Search DB - job_listings, applications, skips, blockers, events, job_state" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="664" height="56" as="geometry"/></mxCell><mxCell id="ERJ2FPzwkd+j2mGJx5lF" value="campaign-api = UI/API - NodePort 30080, /stats /jobs /applications" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="744" y="340" width="664" height="56" as="geometry"/></mxCell><mxCell id="GvfW/WS9UIpWDMJc5GSF" value="Chrome in lubuntu-agent - CDP node IP :30922, used only when APPLY_MODE=live" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1448" y="340" width="664" height="56" as="geometry"/></mxCell><mxCell id="esF/cTutrLiGpuw2y61m" value="mode switch - APPLY_MODE=shadow, msrouter PAUSED (replicas 0), fallback score 70" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="664" height="56" as="geometry"/></mxCell><mxCell id="o080IIYSkJbast2E9zVl" value="Reference flow vs deployed
Reference: External sources -&gt; Discovery &amp; Deduplication Agent -&gt;
Kafka (validated_job_offers) -&gt; worker agents -&gt; Job Search DB / UI.
Deployed: finder -&gt; campaign.jobs -&gt; apply-worker pool -&gt; mongo-0 -&gt;
campaign-api, with campaign.jobs.dlq for poison messages.
The reference names three specialist workers; the deployment runs one
consumer group (apply-workers), so parallelism comes from the three
partitions, not from three services.
Kafka owns delivery, Mongo owns bookkeeping: the offset commits only
after the Mongo write succeeds, and a redelivery declines the action." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffcc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="664" height="174" as="geometry"/></mxCell><mxCell id="ClVvLFwxNTARsq4kpRJR" value="collect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="WLD/i6yRZFJo1tDG9PO3" target="sYNq+e1CDghlNq4zjRSK" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="704" y="68"/><mxPoint x="744" y="68"/></Array></mxGeometry></mxCell><mxCell id="hRhK9QlNN9Y9g4Emg2Jy" value="produce validated offers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sYNq+e1CDghlNq4zjRSK" target="fwxrjThLUIDusi8IVSTF" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1408" y="68"/><mxPoint x="1448" y="68"/></Array></mxGeometry></mxCell><mxCell id="lGXrupuDplAk1r+jCa/c" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="fwxrjThLUIDusi8IVSTF" target="d6cC+RS5DCXljIKQ/Jjb" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="96"/><mxPoint x="372" y="190"/></Array></mxGeometry></mxCell><mxCell id="SCLP0X7x1aYWKzflzFp0" value="the three checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="d6cC+RS5DCXljIKQ/Jjb" target="NTTxYsBoBo/KUOJYOo6n" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="704" y="218"/><mxPoint x="744" y="218"/></Array></mxGeometry></mxCell><mxCell id="ZL1qhX0YEopcM8rZIFuZ" value="maxAttempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="d6cC+RS5DCXljIKQ/Jjb" target="NfGjC93EFgH3m4ttaDQt" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="704" y="218"/><mxPoint x="1448" y="218"/></Array></mxGeometry></mxCell><mxCell id="dPTUejyE+4ahvbGPa2i5" value="record submitted / skipped / blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="d6cC+RS5DCXljIKQ/Jjb" target="jQaBCC1fFFpef9QJ0/pm" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="372" y="246"/><mxPoint x="372" y="340"/></Array></mxGeometry></mxCell><mxCell id="bsp+fKMRS2Pj946Fuc7a" value="apply (live only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="d6cC+RS5DCXljIKQ/Jjb" target="GvfW/WS9UIpWDMJc5GSF" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="372" y="246"/><mxPoint x="1780" y="340"/></Array></mxGeometry></mxCell><mxCell id="zKUVYZ7CNqb/BwOEUL9t" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="jQaBCC1fFFpef9QJ0/pm" target="ERJ2FPzwkd+j2mGJx5lF" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="704" y="368"/><mxPoint x="744" y="368"/></Array></mxGeometry></mxCell><mxCell id="n4rl8FrBJ+HUfP7s11DE" value="observed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ERJ2FPzwkd+j2mGJx5lF" target="esF/cTutrLiGpuw2y61m" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1076" y="396"/><mxPoint x="372" y="490"/></Array></mxGeometry></mxCell><mxCell id="9IHoIheU7uREIxphuLIg" value="gates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;