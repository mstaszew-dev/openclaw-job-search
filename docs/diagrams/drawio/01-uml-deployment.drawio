<mxfile host="app.diagrams.net" agent="gen_mdj.py" version="24.4.0" type="device"><diagram id="H4rj/XC2sPZK5Vq3hBcF" name="01 - deployment: Mac, tailnet, k3s on the lubuntu laptop"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2530" pageHeight="869" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5kxz6FVTIDwNjvd5niRt" value="Mac dev michaels-macbook-air 100.125.162.30 - opencode + Playwright MCP" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="790" height="56" as="geometry"/></mxCell><mxCell id="ONWjiO2Y6ZRfzJIuGjZ1" value="Tailscale tailnet taila0a683.ts.net - overlay net for laptop and pod" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="40" width="790" height="56" as="geometry"/></mxCell><mxCell id="GPlpgzfmtT7oZDkgvuDH" value="lubuntu laptop mstro-travelmate-p215-52 - Ubuntu 22.04.5, 4 vCPU / 7.8 GB, 100.94.153.31" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1700" y="40" width="790" height="56" as="geometry"/></mxCell><mxCell id="O8zFlrMYL2cHwuDTkEMF" value="k3s v1.36.5+k3s1 single node - containerd 2.3.4, no registry, docker save | k3s ctr import" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="790" height="56" as="geometry"/></mxCell><mxCell id="TOiY6+epWXH5G8MB9ez6" value="finder :8081 (Deployment, ns campaign) - discovery, dedupe, eligibility, CV score, produce" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="190" width="790" height="56" as="geometry"/></mxCell><mxCell id="oB8bkNnwcZSx7/eXEcSA" value="apply-worker (Deployment, ns campaign) - consumer group apply-workers, APPLY_MODE=shadow" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1700" y="190" width="790" height="56" as="geometry"/></mxCell><mxCell id="g9DD1hd1eo0DzBhrueTT" value="campaign-api :8080 (NodePort 30080, ns campaign) - /stats /jobs /applications" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="790" height="56" as="geometry"/></mxCell><mxCell id="0oSJGUg8t8c4lD+lOFeY" value="kafka (StatefulSet, apache/kafka:3.7.1) - KRaft, single broker, heap 512 MB, campaign.jobs (3) + dlq (1)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="340" width="790" height="56" as="geometry"/></mxCell><mxCell id="nAE6yVKvelpRaioh1sj9" value="mongo-0 mongo:7 (StatefulSet) - replica set rs0, auth, WiredTiger cache 256 MB" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1700" y="340" width="790" height="56" as="geometry"/></mxCell><mxCell id="+ezFcUEkdSCn9IGcebJE" value="msrouter :3000 (Deployment, ns campaign) - PAUSED, replicas 0 since 2026-10-08" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="790" height="56" as="geometry"/></mxCell><mxCell id="fTAxbZ8FEjk8q8LmQdKX" value="lubuntu-agent (Pod, ns default) - Chrome on Xvfb :99, VNC :5900, CDP :9222, sshd :22" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="790" height="56" as="geometry"/></mxCell><mxCell id="9qTAfjgwGqsj+6XZaJVl" value="hostPath /home/mstro/k3s-pod-data - mongodb, kafka, agent-home, agent-state, playwright-output, tailscale, usr-local" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1700" y="490" width="790" height="56" as="geometry"/></mxCell><mxCell id="pDteoCEV4UEQZnuX9tcq" value="Reading guide
One k3s node runs ns campaign (finder, apply-worker, campaign-api,
kafka-0, mongo-0, msrouter) and ns default (lubuntu-agent).
Images are built on the host with docker and imported with
k3s ctr images import; there is no registry.
msrouter is pinned to 0 replicas and finder runs with
FINDER_SCORING_ENABLED=false while the pipeline is paused.
apply-worker reaches Chrome over CDP at the node IP
port 30922 (NodePort 9222:30922).
Host data lives under /home/mstro/k3s-pod-data, owned by mstro.
The laptop host sshd does not auto-start after a reboot." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffcc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="790" height="189" as="geometry"/></mxCell><mxCell id="u+psN7RI/PRk+lVQmebD" value="ssh -p 2222 / 30022" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="5kxz6FVTIDwNjvd5niRt" target="ONWjiO2Y6ZRfzJIuGjZ1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="68"/><mxPoint x="870" y="68"/></Array></mxGeometry></mxCell><mxCell id="f5TmBHcwyHUQkXJGy7ku" value="tailnet 100.94.153.31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="ONWjiO2Y6ZRfzJIuGjZ1" target="GPlpgzfmtT7oZDkgvuDH" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="68"/><mxPoint x="1700" y="68"/></Array></mxGeometry></mxCell><mxCell id="F+xMXXA6iT/L49bVXUin" value="images imported into containerd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="GPlpgzfmtT7oZDkgvuDH" target="O8zFlrMYL2cHwuDTkEMF" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2095" y="96"/><mxPoint x="435" y="190"/></Array></mxGeometry></mxCell><mxCell id="hr99xGWagMkwUrqE61Vi" value="Deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="O8zFlrMYL2cHwuDTkEMF" target="TOiY6+epWXH5G8MB9ez6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="218"/><mxPoint x="870" y="218"/></Array></mxGeometry></mxCell><mxCell id="Q5SJ4Vaolu9aCq/sLrwp" value="Deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1