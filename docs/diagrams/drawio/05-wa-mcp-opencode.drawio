<mxfile host="app.diagrams.net" agent="gen_mdj.py" version="24.4.0" type="device"><diagram id="vf88AWnpHl9XI/R/s98D" name="05 - whatsapp mcp: opencode only, not part of the pipeline"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1945" pageHeight="689" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="TNpATRSPOk6MGecu9ebD" value="opencode (Mac) - MCP stdio client, mcp.servers.whatsapp in opencode.json" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="595" height="56" as="geometry"/></mxCell><mxCell id="NA8r+Albb+33Bt5K8s+n" value="whatsapp-mcp-server - Python, uv run main.py in tools/whatsapp-mcp" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="675" y="40" width="595" height="56" as="geometry"/></mxCell><mxCell id="Dz/dK3EIa2PC5zp2hRm5" value="whatsapp-bridge - Go / whatsmeow, WhatsApp Web multi-device, QR link" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1310" y="40" width="595" height="56" as="geometry"/></mxCell><mxCell id="BMWecsxyBlO+dLEVg1aa" value="SQLite store/messages.db - local history, chats + messages" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="595" height="56" as="geometry"/></mxCell><mxCell id="hfXsHbIQQxMDy8g/wzGX" value="personal WhatsApp account - paired device, the user controls the phone" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="675" y="190" width="595" height="56" as="geometry"/></mxCell><mxCell id="GH+gfa1weDZcvg3hnbR5" value="MCP tools - search_contacts, list_messages, list_chats, get_chat, get_message_context" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1310" y="190" width="595" height="56" as="geometry"/></mxCell><mxCell id="W0KFPa2+WrYLoUtvPt6I" value="MCP tools - send_message, send_file, send_audio_message, download_media" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="595" height="56" as="geometry"/></mxCell><mxCell id="3gJuZWFRqnn4xMacy5UU" value="scope note - opencode only, NOT wired into the campaign pipeline or k3s" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="675" y="340" width="595" height="56" as="geometry"/></mxCell><mxCell id="M7ezuJAP0cGz02u69PVL" value="opencode only: nothing in the campaign pipeline or the k3s cluster
calls these tools.
Install: brew install go, clone lharries/whatsapp-mcp under
~/ZCodeProject/tools, then go build the bridge.
The bridge keeps WhatsApp Web multi-device state in a local SQLite
store and prints a QR code to pair.
Pairing needs the user's phone (WhatsApp &gt; Linked devices); the
re-link window is about 20 days.
No message is sent by setup; sends happen only on an explicit ask." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffcc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="595" height="159" as="geometry"/></mxCell><mxCell id="LWOZsU6oBjHVOYAoHUCF" value="MCP stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="TNpATRSPOk6MGecu9ebD" target="NA8r+Albb+33Bt5K8s+n" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="68"/><mxPoint x="675" y="68"/></Array></mxGeometry></mxCell><mxCell id="JPrCzsjqmm+gJq5OVZdO" value="HTTP queries / sends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="NA8r+Albb+33Bt5K8s+n" target="Dz/dK3EIa2PC5zp2hRm5" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="68"/><mxPoint x="1310" y="68"/></Array></mxGeometry></mxCell><mxCell id="WJTtQLzGjadt+PP6MnjB" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Dz/dK3EIa2PC5zp2hRm5" target="BMWecsxyBlO+dLEVg1aa" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1607" y="96"/><mxPoint x="337" y="190"/></Array></mxGeometry></mxCell><mxCell id="DHXt31SC1SUofXXEoq/J" value="multi-device protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Dz/dK3EIa2PC5zp2hRm5" target="hfXsHbIQQxMDy8g/wzGX" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1607" y="96"/><mxPoint x="972" y="190"/></Array></mxGeometry></mxCell><mxCell id="B37MLLmLlzfvIM42KVhg" value="tools/list" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;ent