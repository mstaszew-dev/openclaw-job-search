one row per tracker.json import" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="469" height="67" as="geometry"/></mxCell><mxCell id="WmZPfSlabVPjGejPfKah" value="transaction boundaries
recordSubmitted: application + event + job_state
recordSkippedDuplicate / recordBlocked
markTerminal / failJob
Kafka owns delivery, Mongo owns bookkeeping" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="549" y="520" width="469" height="112" as="geometry"/></mxCell><mxCell id="1uuUzkiJl6DeaDrcMf3B" value="Notes the metadata does not advertise
uq_ indexes are not flagged unique in live metadata except
uq_job_listings_source_job; the packed dedupe tuples are enforced by
the write path (insert-if-absent), not by MongoDB.
applications._id is the assigned String source:sourceJobId, so its
uniqueness rides on the default _id_ index.
Only three write paths use a transaction; single-document writes stay
outside on purpose.
job_state is a ledger: it records attempts and outcomes and never
schedules work." style="shape=note;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffcc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="560" height="174" as="geometry"/></mxCell><mxCell id="ODN59BAIFvT3SZP93Wym" value="dedupe: id, company, url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="jmL/QMvX/NamANpctSka" target="y/YNf2w1nIvKbthoAYFL" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1527" y="103"/><mxPoint x="549" y="111"/></Array></mxGeometry></mxCell><mxCell id="W6KPtd+VHKkrFtirZ0X+" value="blockedRepeat counts as duplicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="EGg5RRXH7XimU5nvKeFx" target="y/YNf2w1nIvKbthoAYFL" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="274" y="392"/><mxPoint x="783" y="40"/></Array></mxGeometry></mxCell><mxCell id="u+V5tKAfn6NuPky4b+Jc" value="ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Fgop6FwBdaRECuxpaIzi" target="y/YNf2w1nIvKbthoAYFL" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="783" y="362"/><mxPoint x="783" y="40"/></Array></mxGeometry></mxCell><mxCell id="9NG+YWwnpdcsX3pnSQlh" value="outcome events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="IW4d4Pt5UQUqyn29ISl0" target="Fgop6FwBdaRECuxpaIzi" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1527" y="343"/><mxPoint x="549" y="321"/></Array></mxGeometry></mxCell><mxCell id="jSmlIibmpSnBUF1A9jwE" value="one-shot import" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge=