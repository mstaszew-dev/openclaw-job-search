        {
          "_type": "UMLComponent",
          "_id": "vmhCxxSW2MiOD508Peu+",
          "_parent": {
            "$ref": "eBSMTxPaDIr1DpIouk8S"
          },
          "name": "scope note - opencode only, NOT wired into the campaign pipeline or k3s",
          "visibility": "public"
        },
        {
          "_type": "UMLNote",
          "_id": "/9L4KoMenKJyFz9pLzx5",
          "_parent": {
            "$ref": "eBSMTxPaDIr1DpIouk8S"
          },
          "text": "opencode only: nothing in the campaign pipeline or the k3s cluster\ncalls these tools.\nInstall: brew install go, clone lharries/whatsapp-mcp under\n~/ZCodeProject/tools, then go build the bridge.\nThe bridge keeps WhatsApp Web multi-device state in a local SQLite\nstore and prints a QR code to pair.\nPairing needs the user's phone (WhatsApp > Linked devices); the\nre-link window is about 20 days.\nNo message is sent by setup; sends happen only on an explicit ask."
        },
        {
          "_type": "UMLDependency",
          "_id": "6238PzGw4bdhRhNZ47Yf",
