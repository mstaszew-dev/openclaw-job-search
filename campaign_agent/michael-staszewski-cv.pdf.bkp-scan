<< /A << /JS (// visa-ticket-resolver walkthrough - JavaScript executed by the PDF viewer.\n// Same mechanism as linuxpdf/doompdf: the PDF standard runs embedded JS.\n// Every button payload re-executes this program, so `state` must survive\n// re-declaration \(Acrobat keeps one persistent global scope per document\):\nvar state = \(typeof state !== "undefined" && state && state.buffer\)\n  ? state\n  : { walk: null, step: -1, buffer: [], started: false };\nvar DOC = null;\nfunction field\(name\) {\n  return \(DOC && DOC.getField\) ? DOC.getField\(name\) : null;\n}\nfunction say\(lines\) {\n  state.buffer = state.buffer.concat\(lines\);\n  if \(state.buffer.length > 140\) { state.buffer = state.buffer.slice\(-140\); }\n  renderConsole\(\);\n}\nfunction renderConsole\(\) {\n  var f = field\("career_console"\);\n  if \(f\) { f.value = state.buffer.join\("\\n"\); }\n}\nvar VISA_STEPS = [{"t": "INTRO", "lines": ["ai orchestrator: auto-resolves tickets, controls cost", "dispatcher routes each ticket by complexity to a model tier"]}, {"t": "LISTEN", "lines": ["listen:   jira webhook server catches tickets + comments", "github integration: prs, checks, comments"]}, {"t": "CONTEXT", "lines": ["context:  RAG vector DB \(similar issues\) + static .md skills", "static .md skills sit next to the vector store"]}, {"t": "PLAN", "lines": ["plan:     simple model drafts the fix plan \(cheap tokens\)"]}, {"t": "BUILD", "lines": ["build:    stronger model codes fix + tests, red -> green"]}, {"t": "SCAN", "lines": ["scan:     sonarqube gate - 0 vulnerabilities or back to build"]}, {"t": "PR", "lines": ["pr:       github PR opened, CI status + comments watched"]}, {"t": "REVIEW", "lines": ["review:   third model, other vendor \(claude reviews chatgpt\)", "independent second opinion on the diff"]}, {"t": "LEARN", "lines": ["learn:    on approval, resolution indexed into RAG incrementally"]}, {"t": "RESULT", "lines": ["majority of routine tickets resolved without a human,", "expensive deep-reasoning models reserved for hard cases"]}];\nvar STAMPLI_STEPS = [{"t": "HARVEST", "lines": ["harvest: stampli google drive via takeout \(no API\) -> .md"]}, {"t": "STORE", "lines": ["store:   dynamodb cursor_metadata for horizontal scaling"]}, {"t": "VOLUME", "lines": ["volume:  ~43,200 items / ~1GB: repo, paths, drive, text"]}, {"t": "UPDATE", "lines": ["update:  incremental merges + term reverse index"]}, {"t": "TRANSCRIPTS", "lines": ["extra:   video transcript indexing too"]}, {"t": "SERVE", "lines": ["serve:   exposed as MCP server + skill \(trivial to use\)", "queryable from claude / cursor / codex as just another tool"]}];\nvar AGENT_STEPS = [{"t": "ROLE", "lines": ["role:    director supervises a python job-search agent", "the factory is the surrounding system, not the harness"]}, {"t": "PATTERN", "lines": ["pattern: dark factory - specs, reviews, measures the worker", "supervises, specs, reviews - never trusts blindly"]}, {"t": "GATE", "lines": ["slack:   approval gate in slack before agent overrides", "recommendations land in slack, human approves first"]}, {"t": "RAG", "lines": ["rag:     sqlite + model2vec embeddings via mcp, dedupe + docs", "rag_search_apps dedupes, rag_search_docs retrieves"]}, {"t": "STACK", "lines": ["stack:   python asyncio, playwright mcp, ts loop, kafka stream", "shipped test-first, specs pin each module"]}, {"t": "TRUST", "lines": ["trust:   measured output \(policy, dup risk\), never eyeballed", "discipline over trust: measure, then verify"]}];\nvar WALKS = { visa: VISA_STEPS, stampli: STAMPLI_STEPS, agent: AGENT_STEPS };\nvar rag = {\n  resolutions: [\n    "SS-86100 credits rounding after partial capture",\n    "SS-85740 intacct import customer-not-found \(enum drift\)",\n    "SS-85212 GP eInvoice duplicate batch on retry"\n  ],\n  lookup: function \(key\) { return this.resolutions[0]; }\n};\nvar pipeline = {\n  planTicket: function \(t\) {\n    return ["[plan]   " + t.models.plan + " drafts the fix plan for " + t.key,\n            "         grounded in: " + t.similar];\n  },\n  buildFix: function \(t\) {\n    return ["[build]  " + t.models.build + " implements fix + tests"];\n  },\n  runTests: function \(\) {\n    return ["[test]   red -> green \(high coverage kept\)"];\n  },\n  sonarScan: function \(\) {\n    return ["[scan]   sonarqube: 0 vulnerabilities - gate passed"];\n  },\n  openPr: function \(t\) {\n    return ["[pr]     github #" + t.pr + " opened, CI + comments watched"];\n  },\n  crossVendorReview: function \(t\) {\n    return ["[review] cross-vendor: claude reviews chatgpt diff"];\n  },\n  updateRag: function \(\) {\n    return ["[learn]  resolution indexed into RAG incrementally"];\n  }\n};\nfunction resolveVisa\(key\) {\n  var t = { key: key, pr: 1021, similar: rag.lookup\(key\),\n            models: { plan: "sonnet-class", build: "opus-class" } };\n  var out = ["resolving " + key + " - jira ticket + comments downloaded"];\n  out = out.concat\(pipeline.planTicket\(t\), pipeline.buildFix\(t\),\n                   pipeline.runTests\(\), pipeline.sonarScan\(\),\n                   pipeline.openPr\(t\), pipeline.crossVendorReview\(t\),\n                   pipeline.updateRag\(t\)\);\n  return out;\n}\nfunction startWalk\(name\) {\n  state.walk = name;\n  state.step = 0;\n  return renderStep\(\);\n}\nfunction stepWalk\(delta\) {\n  if \(!state.walk || !WALKS[state.walk]\) { return startWalk\("visa"\); }\n  var len = WALKS[state.walk].length;\n  state.step = Math.max\(0, Math.min\(len - 1, state.step + delta\)\);\n  return renderStep\(\);\n}\nfunction renderStep\(\) {\n  var step = WALKS[state.walk][state.step];\n  var total = WALKS[state.walk].length;\n  var head = "[" + state.walk + "] step " + \(state.step + 1\) + "/" + total\n    + "  " + step.t;\n  return [""].concat\([head], step.lines, ["  \(NEXT/PREV to step, RUN for commands\)"]\);\n}\nvar commands = {\n  "help": function \(\) {\n    return ["commands: help | visa [KEY] | stampli | agent | timeline",\n            "          contact | whoami | availability | clear",\n            "buttons: NEXT / PREV step the active walkthrough"];\n  },\n  "visa": function \(arg\) { return resolveVisa\(arg || "SS-86567"\); },\n  "stampli": function \(\) { return startWalk\("stampli"\); },\n  "agent": function \(\) { return startWalk\("agent"\); },\n  "timeline": function \(\) {\n    return [\n      "2011 700f3c0 init: Weel & Sandvig :: Java/ZK reporting app, Firebird DB  [CPH]",\n      "2013 89396d4 feat: Divendo :: WordPress plugins: maps + forms  [CPH]",\n      "2014 8b4e961 feat: Envisage :: Android port of flagship iOS app  [Toronto]",\n      "2015 34b751a feat: Nintendo Enthusiast :: Laravel scripts + MySQL schema move  [Toronto]",\n      "2016 465e2ac feat: OlehPay :: payments: PayPal, Authorize.Net, PCI/TLS  [Jerusalem]",\n      "2017 0170721 feat: TNS Telecom :: AngularJS/PHP/C#/MS-SQL SPA flows  [Jerusalem]",\n      "2018 50c9ed6 perf: Trackonomics :: ES/Symfony APIs, headless scanning  [TLV]",\n      "2019 86afc66 scale: TOMIA :: telecom SS7/Diameter/LTE-5G, Spring/Oracle  [Ra'anana]",\n      "2021 ec497bd feat: TalkAndSave :: Node.js REST + React ops tools  [Jerusalem]",\n      "2022 fea8e8c feat: Trendsales :: Java11/Spring/ES/Stripe admin platform  [CPH]",\n      "2023 e297070 feat: Krieger Digital :: Spring/Kotlin microservices on K8s  [Berlin]",\n      "2024 e7ed0a8 merge: Wipro / Visa :: 20mo Java backend, payment systems  [remote]",\n      "2026 3b75560 merge: Stampli :: ERP escalations: NetSuite/Intacct/GP  [IL remote]"\n    ];\n  },\n  "contact": function \(\) {\n    return [\n      "+972-55-934-4507  |  +48-790-775-407  |  mst.rocking@gmail.com",\n      "github.com/mstaszew-dev  |  Petah Tikva, IL  |  IL+PL  |  B2B \(EU VAT\)"\n    ];\n  },\n  "whoami": function \(\) { return ["Micha\\u0142 Staszewski - Senior Full Stack SWE - 14+ yrs production"]; },\n  "availability": function \(\) { return ["open to long-term | from Jul 15, 2026 | IL remote/hybrid | EU full-remote B2B"]; },\n  "clear": function \(\) { state.buffer = []; renderConsole\(\); return []; }\n};\nfunction dispatch\(line\) {\n  var parts = String\(line\).trim\(\).split\(/\\s+/\);\n  var name = \(parts[0] || ""\).toLowerCase\(\);\n  if \(!name\) { return; }  // empty RUN press: echo only\n  var fn = commands[name];\n  if \(!fn\) {\n    say\(["sh: command not found: " + name + " \(try help\)"]\);\n    return;\n  }\n  say\(fn\(parts.slice\(1\).join\(" "\)\) || []\);\n}\nfunction careerMain\(doc\) {\n  DOC = doc || null;\n  if \(!DOC || !DOC.getField\) { return; }\n  if \(!state.started\) {\n    state.started = true;\n    say\(["michael@cv: live walkthrough - this output is computed",\n         "by JavaScript embedded in this PDF, right now.",\n         "time: " + new Date\(\),\n         "",\n         "type help + press RUN, or press NEXT to step through",\n         "  1. visa: the ai ticket resolver pipeline",\n         "  2. stampli: the metadata harvester",\n         "  3. agent: the python director supervising the worker",\n         ""]\);\n  }\n}\nfunction careerRun\(\) {\n  if \(!DOC\) { return; }\n  var f = field\("career_input"\);\n  var line = \(f && f.value\) ? String\(f.value\) : "";\n  if \(f\) { f.value = ""; }\n  say\(["$ " + line]\);\n  dispatch\(line\);\n}\nfunction careerNext\(\) { if \(DOC\) { say\(stepWalk\(1\)\); } }\nfunction careerPrev\(\) { if \(DOC\) { say\(stepWalk\(-1\)\); } }\ncareerMain\(this\); careerPrev\(\);\n) /S /JavaScript >> /AP << /D 14 0 R /N 15 0 R >> /BS << /S /S /W .8 >> /DA (1 1 1 rg /Helv 8 Tf) /F 4 /FT /Btn /Ff 65536 /MK << /BC [ .247 .725 .314 ] /BG [ .05 .15 .08 ] /CA (PREV) >> /NM (fitz-W3) /Rect [ 460 120 518 136 ] /Subtype /Widget /T (career_prev) /TU (PREV) /Type /Annot >>
