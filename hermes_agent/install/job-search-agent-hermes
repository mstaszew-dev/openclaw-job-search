#!/usr/bin/env zsh
# Supervised launcher for the Hermes job-search campaign agent.
#
# Primary campaign launcher (the python agent's launcher is retired).
# pgrep-based supervision (msrouter Director) detects it via the launcher
# name pre-exec and the 'python -m jobhermes' cmdline post-exec (the exec
# below replaces this zsh process).
#
# NOTE: starting this launcher begins REAL job applications once the
# campaign is not complete. It does NOT register cron; supervision is
# expected from an external watcher (Director), same as the Python agent.
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
REPO_ROOT="${SCRIPT_DIR:h}"

if [[ ! -d "/Users/mst/Downloads/job-search/job-apply" ]]; then
  print -u2 "campaign dir missing; refusing to start"
  exit 1
fi

cd "$REPO_ROOT"

PYTHON_BIN="python3"
if [[ -x "$REPO_ROOT/.venv/bin/python" ]]; then
  PYTHON_BIN="$REPO_ROOT/.venv/bin/python"
fi

print "job-search-agent-hermes: starting tick loop (Ctrl-C to stop)"
exec env PYTHONPATH=src "$PYTHON_BIN" -m jobhermes --loop
